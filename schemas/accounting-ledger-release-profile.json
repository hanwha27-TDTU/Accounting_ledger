    }
  ],
  "releaseEdges": [
    { "from": "inputs-finalized", "to": "narrow-gates", "reason": "검사 입력과 생성물을 먼저 고정한다" },
    { "from": "narrow-gates", "to": "required-ci", "reason": "조기경보를 통과한 개정만 원격 전체 게이트로 보낸다" },
